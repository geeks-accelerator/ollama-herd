<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.geeksaccelerator.ollama-herd.router</string>
  <key>Comment</key><string>ollama-herd ROUTER (:11435) — FastAPI scoring/queues/dashboard. Logs go to ~/.fleet-manager/logs (NOT the project dir — macOS 26 TCC blocks launchd writes under ~/Desktop, which is why bot-crons had to move off it). Entry points auto-load ~/.fleet-manager/env, so FLEET_* vars need no duplication here. KeepAlive restarts on crash but NOT after a clean exit, so a deliberate stop stays stopped.</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/path/to/ollama-herd/.venv/bin/python3</string>
    <string>/Users/YOUR_USER/path/to/ollama-herd/.venv/bin/herd</string>
  </array>

  <key>WorkingDirectory</key><string>/Users/YOUR_USER/path/to/ollama-herd</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/YOUR_USER</string>
    <!-- mlx_lm.server lives in ~/.local/bin; mlx.launch + uv in /opt/homebrew/bin.
         MlxSupervisor resolves them via _which_extended(), which still needs a
         sane PATH. launchd gives almost none by default. -->
    <key>PATH</key><string>/Users/YOUR_USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>

  <key>StandardOutPath</key><string>/Users/YOUR_USER/.fleet-manager/logs/launchd-herd.out</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/.fleet-manager/logs/launchd-herd.err</string>
</dict>
</plist>
